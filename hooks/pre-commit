#!/bin/bash

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "     PRE-COMMIT HOOK: Запуск модульных тестов"
echo "═══════════════════════════════════════════════════════════"
echo ""

# Путь к тестам
TEST_EXE="lab3/RealEstateApp/build/test/debug/RealEstateApp_tests.exe"

# Альтернативный путь
if [ ! -f "$TEST_EXE" ]; then
    TEST_EXE="lab3/RealEstateApp/build/Desktop_Qt_6_11_0_MinGW_64_bit-test2/debug/RealEstateApp_tests.exe"
fi

# Проверяем изменения в папке lab3/RealEstateApp
check_code_changes() {
    # Проверяем только файлы в папке lab3/RealEstateApp
    if git diff --cached --name-only | grep "lab3/RealEstateApp" | grep -E "\.(cpp|h|hpp|pro)$" > /dev/null; then
        return 0  # Есть изменения в коде
    fi
    return 1  # Нет изменений
}

# Если нет изменений в коде - пропускаем
if ! check_code_changes; then
    echo "📦 Нет изменений в исходном коде RealEstateApp"
    echo "✅ Коммит разрешен"
    exit 0
fi

echo "📦 Обнаружены изменения в коде RealEstateApp"

# Проверяем существование тестов
if [ ! -f "$TEST_EXE" ]; then
    echo "⚠️ Тесты не найдены: $TEST_EXE"
    echo "✅ Коммит разрешен (тесты не настроены)"
    exit 0
fi

# Запускаем тесты
echo "🧪 Запуск тестов..."
echo "───────────────────────────────────────────────────────────────"
"$TEST_EXE"
TEST_RESULT=$?
echo "───────────────────────────────────────────────────────────────"

if [ $TEST_RESULT -eq 0 ]; then
    echo ""
    echo "✅ Тесты пройдены!"
    echo "✅ Коммит разрешен"
    exit 0
else
    echo ""
    echo "❌ Тесты не пройдены!"
    echo "❌ КОММИТ ОТМЕНЕН"
    echo ""
    echo "Для принудительного коммита: git commit --no-verify"
    exit 1
fi

