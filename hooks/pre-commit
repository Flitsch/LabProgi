#!/bin/bash

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "     PRE-COMMIT HOOK: Запуск файловых тестов"
echo "═══════════════════════════════════════════════════════════"
echo ""

# Правильный путь к тестам
TEST_EXE="$HOME/LabProgi/lab4/build/Desktop_Qt_6_11_0_MinGW_64_bit-test2/debug/RealEstateApp_tests.exe"

# Проверка существования тестов
if [ ! -f "$TEST_EXE" ]; then
    echo "❌ Тесты не найдены по пути:"
    echo "   $TEST_EXE"
    exit 1
fi

# Проверка изменений в коде
check_changes() {
    git diff --cached --name-only | grep -qE "\.(cpp|h|hpp|pro|txt)$"
    return $?
}

if check_changes; then
    echo "📝 Обнаружены изменения в коде"
    echo "🧪 Запуск файловых тестов..."
    echo "───────────────────────────────────────────────────────────────"
    
    # Запускаем тесты и сохраняем результат
    "$TEST_EXE" 2>&1 | grep -E "(PASS|FAIL|Totals)"
    TEST_RESULT=${PIPESTATUS[0]}
    
    echo "───────────────────────────────────────────────────────────────"
    
    # Проверяем, есть ли FAIL в выводе
    if "$TEST_EXE" 2>&1 | grep -q "FAIL!"; then
        echo ""
        echo "❌ ТЕСТЫ НЕ ПРОЙДЕНЫ!"
        echo "❌ КОММИТ ОТМЕНЕН"
        exit 1
    else
        echo ""
        echo "✅ ТЕСТЫ ПРОЙДЕНЫ!"
        echo "✅ Коммит разрешен"
        exit 0
    fi
else
    echo "📝 Нет изменений в коде"
    echo "✅ Коммит разрешен"
    exit 0
fi
